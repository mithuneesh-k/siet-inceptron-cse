{
  "name": "ssiet-cse-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm run build --prefix frontend",
    "test:backend": "npm test --prefix backend",
    "lint:frontend": "npm run lint --prefix frontend",
    "check": "npm run lint:frontend && npm run build:frontend && npm run test:backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
